# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# ---------------------------------------------------------------------------
# Native identity — PUBLIC identifiers only. Never put an Apple .p8 key, an
# Apple client-secret JWT or a Google client secret here: those belong in the
# backend auth settings and are never shipped to a device.
# Every value is optional; unset simply reports "not configured" in
# Settings -> Sign-in & Links.
# ---------------------------------------------------------------------------

# Final iOS bundle id / Android applicationId (owner decision).
VITE_NATIVE_APP_ID=

# Apple Developer: Services ID with Sign in with Apple enabled, and Team ID.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_TEAM_ID=

# Google Cloud: per-platform OAuth client IDs. The web client is the one the
# backend auth provider is configured with; iOS/Android are separate clients.
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# Comma-separated hosts allowed to open the app via Universal / App Links.
VITE_UNIVERSAL_LINK_HOSTS=

# Set to true ONLY after the association files are live and a real device has
# opened an https link straight into the app.
VITE_ASSOCIATED_DOMAINS_VERIFIED=false
